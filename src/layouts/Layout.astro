---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Glory&family=Gochi+Hand&family=Inter&family=Irish+Grover&family=Jua&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<!-- The design is a fixed 1280x832 canvas; it is scaled as a whole to fit the window. -->
		<div class="viewport">
			<main class="stage">
				<slot />
			</main>
		</div>
		<script>
			const fit = () => {
				const scale = Math.min(window.innerWidth / 1280, window.innerHeight / 832);
				document.documentElement.style.setProperty('--scale', String(scale));
			};
			fit();
			window.addEventListener('resize', fit);
		</script>
	</body>
</html>

<style is:global>
	:root {
		--navy: #181b56;
		--sidebar-bg: linear-gradient(rgba(74, 68, 89, 0.16), rgba(74, 68, 89, 0.16)), var(--navy);
		--frame-border: #5c3cab;
		--tile: #d9d9d9;
		--cream: #f5f1e3;
		--pink: #f26ca7;
		--blush: #f7bdbe;
		--sky: #bdeef7;
		--royal: #05299e;
		--lavender: #947bd3;
		--font-display: 'Jua', sans-serif;
		--font-hand: 'Gochi Hand', cursive;
		--font-body: 'Glory', sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		height: 100%;
	}

	body {
		background: var(--sidebar-bg);
		overflow: hidden;
	}

	.viewport {
		display: grid;
		place-items: center;
		width: 100vw;
		height: 100dvh;
	}

	.stage {
		position: relative;
		flex: none;
		width: 1280px;
		height: 832px;
		overflow: hidden;
		background: var(--sidebar-bg);
		transform: scale(var(--scale, 1));
	}

	/* Positioned layer helpers shared by every page */
	.abs {
		position: absolute;
	}

	.crop {
		position: absolute;
		overflow: hidden;
		pointer-events: none;
	}

	.crop > img {
		position: absolute;
		max-width: none;
	}

	.fill {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
		pointer-events: none;
	}

	.rot-7 {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.rot-7 > img {
		flex: none;
		width: 284.46px;
		height: 559.761px;
		object-fit: cover;
		rotate: -7deg;
		pointer-events: none;
	}

	/* Shared scenery crops */
	.aquarium-img {
		left: 0.01%;
		top: -0.04%;
		width: 107.48%;
		height: 100%;
	}

	.rock-img {
		left: 0;
		top: -15.29%;
		width: 100%;
		height: 115.23%;
	}

	.seaweed-left-img {
		left: 14.65%;
		top: -4.72%;
		width: 70.64%;
		height: 109.6%;
	}

	.seaweed-right-img {
		left: -222.25%;
		top: -60.36%;
		width: 303.19%;
		height: 178.27%;
	}

	.sidebar {
		position: absolute;
		background: var(--sidebar-bg);
	}

	a {
		color: inherit;
		text-decoration: none;
	}
</style>
