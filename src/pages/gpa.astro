---
import Layout from '../layouts/Layout.astro';
---

<Layout title="GPA Calculator">
	<div class="crop aquarium">
		<img class="aquarium-img" src="/images/aquarium.png" alt="" />
	</div>

	<div class="abs rock">
		<div class="crop rock-layer">
			<img class="rock-img" src="/images/rock.png" alt="" />
		</div>
		<div class="abs seaweed-mid">
			<img class="fill" src="/images/seaweed-mid.gif" alt="" />
		</div>
	</div>

	<div class="sidebar todo-sidebar"></div>

	<div class="abs title-banner">
		<img src="/images/todo-title-banner.svg" width="32" height="32" alt="" />
	</div>
	<h1 class="abs title outlined">GPA :</h1>

	<button class="abs action add" type="button" aria-label="Add class">
		<img src="/images/todo-add.png" alt="" />
	</button>
	<button class="abs action edit" type="button" aria-label="Edit class">
		<img src="/images/todo-edit.png" alt="" />
	</button>
	<button class="abs action delete" type="button" aria-label="Delete class">
		<img src="/images/todo-delete.png" alt="" />
	</button>
	<button class="abs action clipboard" type="button" aria-label="Class details">
		<img src="/images/todo-clipboard.png" alt="" />
	</button>

	<h2 class="abs my-tasks outlined">classes:</h2>

	<article class="abs task">
		<span class="badge">1</span>
		<span class="field name">Subject:</span>
		<span class="field complete-by">Grade:</span>
		<span class="field days-left">| Credit hours:</span>
	</article>

	<div class="crop seaweed-right">
		<img class="seaweed-right-img" src="/images/seaweed.png" alt="" />
	</div>
	<div class="crop seaweed-left">
		<img class="seaweed-left-img" src="/images/seaweed-left.gif" alt="" />
	</div>
	<div class="abs rot-7 seaweed-tall">
		<img src="/images/seaweed-tall.gif" alt="" />
	</div>
</Layout>

<style>
	.aquarium {
		left: 0;
		top: 0;
		width: 987px;
		height: 832px;
	}

	.rock {
		left: 10px;
		top: -4px;
		width: 1280px;
		height: 834px;
		overflow: hidden;
	}

	.rock-layer {
		inset: 0;
	}

	.seaweed-mid {
		left: 433px;
		top: 417px;
		width: 276px;
		height: 457px;
	}

	.todo-sidebar {
		left: 620px;
		top: -2px;
		width: 660px;
		height: 834px;
	}

	.title-banner {
		left: 424px;
		top: 37px;
		width: 433px;
		height: 107px;
	}

	/* Pink outline drawn behind the cream fill */
	.outlined {
		margin: 0;
		font-weight: 400;
		color: var(--cream);
		-webkit-text-stroke: 8px var(--pink);
		paint-order: stroke fill;
		white-space: nowrap;
	}

	.title {
		left: 684px;
		top: 26px;
		width: 266px;
		font: 400 60px/normal 'Irish Grover', cursive;
	}

	.my-tasks {
		left: 689px;
		top: 240px;
		width: 182px;
		font: 400 37px/normal var(--font-hand);
	}

	.action {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
		transition: transform 0.15s ease;
	}

	.action:hover,
	.action:focus-visible {
		transform: scale(1.08);
	}

	.action img {
		flex: none;
		width: 100px;
		height: 100px;
		object-fit: cover;
		pointer-events: none;
	}

	.add {
		left: 678px;
		top: 119px;
		width: 100px;
		height: 100px;
	}

	.edit {
		left: 812.58px;
		top: 110.58px;
		width: 116.845px;
		height: 116.845px;
	}

	.edit img {
		rotate: 10.71deg;
	}

	.delete {
		left: 961.6px;
		top: 113.6px;
		width: 104.808px;
		height: 104.808px;
	}

	.delete img {
		rotate: 2.83deg;
	}

	.clipboard {
		left: 1100px;
		top: 113px;
		width: 111.665px;
		height: 111.665px;
	}

	.clipboard img {
		rotate: 7.15deg;
	}

	.task {
		left: 680px;
		top: 293px;
		width: 550px;
		height: 87px;
		border: 1px solid var(--pink);
		border-radius: 15px;
		background: var(--cream);
	}

	/* Children are positioned from the card's padding box (inside the 1px border) */
	.badge {
		position: absolute;
		left: 9px;
		top: 12px;
		width: 60px;
		height: 60px;
		border-radius: 15px;
		background: var(--pink);
		font: 400 40px/60px 'Inter', sans-serif;
		color: white;
		text-align: center;
	}

	.field {
		position: absolute;
		height: 27px;
		font: 400 22px/normal var(--font-body);
		color: var(--lavender);
		white-space: nowrap;
	}

	.name {
		left: 79px;
		top: 16px;
		width: 320px;
		font-size: 26px;
		color: var(--royal);
	}

	.complete-by {
		left: 81px;
		top: 46px;
		width: 202px;
	}

	.days-left {
		left: 283px;
		top: 16px;
		width: 211px;
	}

	.seaweed-right {
		left: 1082px;
		top: 561px;
		width: 225px;
		height: 287px;
	}

	.seaweed-left {
		left: -26px;
		top: 417px;
		width: 326px;
		height: 428px;
	}

	.seaweed-tall {
		left: 97px;
		top: 278px;
		width: 350.558px;
		height: 590.256px;
	}
</style>
