---
import Layout from '../layouts/Layout.astro';

interface Fish {
	src: string;
	name: string;
	x: number;
	y: number;
	w: number;
	h: number;
	// Crop of the square source image inside the fish box, as in Figma
	crop: string;
}

interface Item {
	x: number;
	y: number;
	price: string;
	priceX: number;
	priceY: number;
	// Sand-dollar icon next to the price
	coinX: number;
	coinY: number;
	fish?: Fish;
}

// Card, price-label, coin and fish positions from the Figma frame
const items: Item[] = [
	{
		x: 713, y: 183, price: 'price 10', priceX: 765, priceY: 337, coinX: 842, coinY: 329,
		fish: { src: '/images/fish-teal.png', name: 'Teal fish', x: 691, y: 178, w: 219, h: 219, crop: 'left:0;top:0;width:100%;height:100%' },
	},
	{
		x: 1013, y: 183, price: 'price 20', priceX: 1050, priceY: 339, coinX: 1133, coinY: 329,
		fish: { src: '/images/fish-brown.png', name: 'Brown fish', x: 1010, y: 212, w: 224, h: 76, crop: 'left:0;top:-194.25%;width:100%;height:294.25%' },
	},
	{
		x: 713, y: 394, price: 'price 1000', priceX: 745, priceY: 554, coinX: 855, coinY: 543,
		fish: { src: '/images/fish-yellow.png', name: 'Yellow fish', x: 691, y: 397, w: 198, h: 143, crop: 'left:-85.51%;top:0;width:185.51%;height:256.86%' },
	},
	{
		x: 1013, y: 394, price: 'price  30', priceX: 1060, priceY: 553, coinX: 1156, coinY: 546,
		fish: { src: '/images/fish-blue.png', name: 'Blue fish', x: 1022, y: 395, w: 199, h: 147, crop: 'left:-3.18%;top:-3.23%;width:152.68%;height:207.01%' },
	},
	{
		x: 713, y: 605, price: 'price 25', priceX: 758, priceY: 753, coinX: 839, coinY: 748,
		fish: { src: '/images/fish-orange.png', name: 'Orange fish', x: 714, y: 597, w: 196, h: 141, crop: 'left:0;top:-39.22%;width:100%;height:139.22%' },
	},
	{ x: 1013, y: 605, price: 'price ', priceX: 1076, priceY: 757, coinX: 1132, coinY: 751 },
];
---

<Layout title="Fish Shop">
	<div class="crop aquarium">
		<img class="aquarium-img" src="/images/aquarium.png" alt="" />
	</div>
	<div class="abs aquarium-clip">
		<div class="abs rock">
			<div class="crop rock-layer">
				<img class="rock-img" src="/images/rock.png" alt="" />
			</div>
			<div class="abs seaweed-mid">
				<img class="fill" src="/images/seaweed-mid.gif" alt="" />
			</div>
		</div>
	</div>

	<div class="sidebar shop-sidebar"></div>

	<h1 class="abs title">FISH SHOP</h1>

	<div class="abs balance-bar"></div>
	<p class="abs balance-label">MY BALANCE</p>
	<img class="abs sand-dollar" src="/images/sand-dollar.png" alt="Sand dollar" />

	<div class="abs panel"></div>
	<ul class="shop-items">
		{
			items.map(({ x, y, price, priceX, priceY, coinX, coinY, fish }) => (
				<li>
					<div class="abs card" style={`left:${x}px;top:${y}px`} />
					<p class="abs price" style={`left:${priceX}px;top:${priceY}px`}>
						{price}
					</p>
					<img
						class="abs coin"
						src="/images/sand-dollar.png"
						alt="sand dollars"
						style={`left:${coinX}px;top:${coinY}px`}
					/>
					{fish && (
						<div
							class="crop fish"
							style={`left:${fish.x}px;top:${fish.y}px;width:${fish.w}px;height:${fish.h}px`}
						>
							<img src={fish.src} alt={fish.name} style={fish.crop} />
						</div>
					)}
				</li>
			))
		}
	</ul>

	<div class="abs rot-7 seaweed-tall">
		<img src="/images/seaweed-tall.gif" alt="" />
	</div>

	<div class="frame-border"></div>
</Layout>

<style>
	.aquarium,
	.aquarium-clip {
		left: 0;
		top: 0;
		width: 792px;
		height: 832px;
		overflow: hidden;
	}

	.rock {
		left: 6px;
		top: -4px;
		width: 1280px;
		height: 834px;
		overflow: hidden;
	}

	.rock-layer {
		inset: 0;
	}

	.seaweed-mid {
		left: 419px;
		top: 417px;
		width: 276px;
		height: 457px;
	}

	.shop-sidebar {
		left: 640px;
		top: 0;
		width: 640px;
		height: 834px;
	}

	.title {
		left: 865px;
		top: 35px;
		margin: 0;
		font: 400 48px/normal var(--font-display);
		color: white;
		white-space: nowrap;
	}

	.balance-bar {
		left: 775px;
		top: 95px;
		width: 371px;
		height: 45px;
		border-radius: 17px;
		background: var(--blush);
	}

	.balance-label {
		left: 787px;
		top: 105px;
		margin: 0;
		font: 400 24px/normal var(--font-display);
		color: white;
		white-space: nowrap;
	}

	.sand-dollar {
		left: 920px;
		top: 81px;
		width: 76px;
		height: 73px;
		object-fit: cover;
	}

	.panel {
		left: 670px;
		top: 158px;
		width: 579px;
		height: 634px;
		border-radius: 27px;
		background: var(--sky);
	}

	.shop-items {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.card {
		width: 198px;
		height: 146px;
		border-radius: 22px;
		background: white;
	}

	.price {
		margin: 0;
		font: 400 24px/normal var(--font-display);
		color: black;
		white-space: pre;
	}

	.coin {
		width: 45px;
		height: 44px;
		object-fit: cover;
	}

	/* Fish sit above every card and label, as in Figma */
	.fish {
		z-index: 1;
	}

	.seaweed-tall {
		left: 83px;
		top: 259px;
		width: 350.558px;
		height: 590.256px;
	}

	.frame-border {
		position: absolute;
		inset: 0;
		border: 1px solid var(--frame-border);
		pointer-events: none;
	}
</style>
